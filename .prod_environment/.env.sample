# Database Configuration
# In development, this connects to an existing Docker network
DATABASE_URL=postgresql://monkey_admin:monkey_pass_server@rm-monkeycore-postgres:5432/chesscoach_db

APP_SUBDOMAIN=ejemplo.remotemonkeys.ai
NEXTAUTH_SECRET='%jxWWfgj^$F;s:}w{58(H*ENp0kb!UX/test'
# Auth Configuration
NEXTAUTH_URL=https://${APP_SUBDOMAIN}
AUTH_SECRET='%jxWWfghj^$F;s:}w{58(H*ENp0kb!UX/test'
AUTH_URL=https://${APP_SUBDOMAIN}

# Google OAuth (Optional - leave blank if not using Google login in production)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Project Settings
PORT=3014
NODE_ENV=production

# El subdominio que Terraform o tú decidieron para esta app

# El nombre de la red debe coincidir con el de MonkeyCore
DOCKER_NETWORK_NAME=rm_monkeycore_network
AUTH_TRUST_HOST=true

# Etiquetas de imagen para el flujo de despliegue (Usado por Makefiles)
PROD_PREVIOUS_TAG=0.1.0
PROD_DEPLOY_TAG=1.0.0

# Email Configuration (Nodemailer)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=tu-correo@gmail.com
EMAIL_SERVER_PASSWORD=tu-app-password
EMAIL_FROM=tu-correo@gmail.com

# Feature Flags
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_WALKTHROUGH=true
NEXT_PUBLIC_ENABLE_SCREEN_LOCK=true
NEXT_PUBLIC_ENABLE_AI_CHAT=true

# AI Assistant Configuration (mock, openai, gemini, anthropic).
AI_PROVIDER=mock

EVOLUTION_API_URL=https://w.serkoi.com
EVOLUTION_API_KEY="AQUI_KEY"